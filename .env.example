# Development defaults to a private SQLite file. Do not put it under public/.
# On a persistent Node server, place the file on a backed-up persistent volume.
BOOKING_DATABASE_URL=file:.data/sarah.db

# On Vercel/serverless, use durable remote libSQL/Turso instead:
# BOOKING_DATABASE_URL=libsql://your-database.turso.io
BOOKING_DATABASE_AUTH_TOKEN=

# Postgres on the VPS uses a private URL. Do not commit the real password.
# BOOKING_DATABASE_URL=postgresql://sarahreader:password@infra-postgres-1:5432/sarahreader?sslmode=disable

# Required for first admin setup in ALL environments, including localhost.
# Leave empty to keep both the setup API and UI locked. Minimum 32 characters.
# Generate privately with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Enter the value in the /admin/setup form, then remove this environment variable
# after creating your admin account. Setup is permanently closed once an account exists.
ADMIN_SETUP_TOKEN=
